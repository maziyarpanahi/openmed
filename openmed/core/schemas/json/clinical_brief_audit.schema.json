{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmed.life/schemas/clinical_brief_audit.schema.json",
  "title": "OpenMed clinical brief audit record",
  "schema_version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "backend_id",
    "citations",
    "digest",
    "envelope",
    "metrics",
    "profile_digest",
    "provenance",
    "refusal_reason",
    "review_packet",
    "schema_version",
    "stages",
    "status",
    "summary_characters",
    "summary_digest",
    "verdicts"
  ],
  "properties": {
    "backend_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "citations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/citation"
      }
    },
    "digest": {
      "$ref": "#/$defs/digest"
    },
    "envelope": {
      "$ref": "#/$defs/envelope"
    },
    "metrics": {
      "$ref": "#/$defs/metrics"
    },
    "profile_digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "$ref": "#/$defs/guarded_provenance"
    },
    "refusal_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/refusal_reason"
        },
        {
          "type": "null"
        }
      ]
    },
    "review_packet": {
      "$ref": "#/$defs/review_packet"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "needs_review",
        "refused"
      ]
    },
    "summary_characters": {
      "type": "integer",
      "minimum": 0
    },
    "summary_digest": {
      "$ref": "#/$defs/digest"
    },
    "verdicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/verdict"
      }
    }
  },
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_index",
        "output_end",
        "output_start",
        "source_end",
        "source_start"
      ],
      "properties": {
        "claim_index": {
          "type": "integer",
          "minimum": 0
        },
        "output_end": {
          "type": "integer",
          "minimum": 0
        },
        "output_start": {
          "type": "integer",
          "minimum": 0
        },
        "source_end": {
          "type": "integer",
          "minimum": 0
        },
        "source_start": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires_human_review"
      ],
      "properties": {
        "disclaimer": {
          "const": "This summary is for human review only. It is not a diagnosis, medical advice, or a substitute for qualified clinical judgment."
        },
        "human_review_mode": {
          "type": "boolean"
        },
        "is_diagnostic": {
          "const": false
        },
        "provenance": {
          "$ref": "#/$defs/envelope_provenance"
        },
        "refusal_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requires_human_review": {
          "const": true
        },
        "schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "ready",
            "refused"
          ]
        },
        "summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/envelope_summary"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "envelope_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_digest"
      ],
      "properties": {
        "summary_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "citation_support": {
          "$ref": "#/$defs/citation_support"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "demographics": {
          "$ref": "#/$defs/demographics"
        },
        "leakage": {
          "$ref": "#/$defs/leakage"
        },
        "temporal_order": {
          "$ref": "#/$defs/temporal_order"
        },
        "unsupported_claims": {
          "$ref": "#/$defs/unsupported_claims"
        }
      }
    },
    "refusal_reason": {
      "enum": [
        "empty_evidence",
        "invalid_evidence",
        "invalid_input",
        "nli_rejected",
        "nli_unavailable",
        "privacy",
        "review_required",
        "stage_failed",
        "unsupported_claim"
      ]
    },
    "review_citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation_id",
        "source"
      ],
      "properties": {
        "citation_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/review_metadata"
        },
        "protected_text_available": {
          "const": true
        },
        "published": {
          "type": "string"
        },
        "relevance": {
          "type": "number"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "source_hash": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      }
    },
    "review_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "label",
        "status"
      ],
      "properties": {
        "attributes": {
          "$ref": "#/$defs/review_metadata"
        },
        "citation_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "number"
        },
        "finding_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "protected_text_available": {
          "const": true
        },
        "source_hash": {
          "type": "string"
        },
        "source_offset": {
          "$ref": "#/$defs/source_offset"
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "uncertainty": {
          "type": "number"
        }
      }
    },
    "review_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocking",
        "gate_id",
        "passed",
        "reason",
        "severity"
      ],
      "properties": {
        "blocking": {
          "type": "boolean"
        },
        "citation_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "details": {
          "$ref": "#/$defs/review_metadata"
        },
        "gate_id": {
          "type": "string",
          "minLength": 1
        },
        "passed": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "reason_hash": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "review_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advisory",
        "citations",
        "findings",
        "gate_results",
        "packet_id",
        "privacy",
        "review_status",
        "schema_version",
        "summary"
      ],
      "properties": {
        "advisory": {
          "const": "Human-review packets are assistive evidence summaries, not clinical decisions, release approvals, or compliance certifications."
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/review_citation"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/review_finding"
          }
        },
        "gate_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/review_gate"
          }
        },
        "packet_id": {
          "type": "string",
          "minLength": 1
        },
        "privacy": {
          "$ref": "#/$defs/review_privacy"
        },
        "review_status": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "const": "openmed.clinical.review_packet.v1"
        },
        "summary": {
          "$ref": "#/$defs/review_summary"
        }
      }
    },
    "review_privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protected_text_available",
        "protected_text_included",
        "protected_text_policy"
      ],
      "properties": {
        "protected_text_available": {
          "type": "boolean"
        },
        "protected_text_included": {
          "const": false
        },
        "protected_text_policy": {
          "const": "explicit_local_opt_in"
        }
      }
    },
    "review_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation_count",
        "failed_gate_count",
        "finding_count",
        "gate_count",
        "review_required"
      ],
      "properties": {
        "citation_count": {
          "type": "integer",
          "minimum": 0
        },
        "failed_gate_count": {
          "type": "integer",
          "minimum": 0
        },
        "finding_count": {
          "type": "integer",
          "minimum": 0
        },
        "gate_count": {
          "type": "integer",
          "minimum": 0
        },
        "review_required": {
          "const": true
        }
      }
    },
    "source_offset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "end",
        "start"
      ],
      "properties": {
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "start": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_index",
        "label"
      ],
      "properties": {
        "claim_index": {
          "type": "integer",
          "minimum": 0
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "guarded_model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "model_fingerprint": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "tokenizer_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "tokenizer_fingerprint": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "model_fingerprint",
        "model_id",
        "revision",
        "tokenizer_fingerprint",
        "tokenizer_id"
      ]
    },
    "guarded_transition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "from_state": {
          "enum": [
            "abstained",
            "approved",
            "in_review",
            "needs_revision",
            "queued",
            "rejected",
            "reopened"
          ]
        },
        "to_state": {
          "enum": [
            "abstained",
            "approved",
            "in_review",
            "needs_revision",
            "queued",
            "rejected",
            "reopened"
          ]
        },
        "reviewer_fingerprint": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
        }
      },
      "required": [
        "from_state",
        "reason_code",
        "reviewer_fingerprint",
        "sequence",
        "to_state"
      ]
    },
    "guarded_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/digest"
        },
        "source_offsets": {
          "anyOf": [
            {
              "$ref": "#/$defs/source_offset"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
        }
      },
      "required": [
        "evidence_hash",
        "evidence_id",
        "kind",
        "source_offsets"
      ]
    },
    "guarded_integrity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "missing_evidence_count": {
          "type": "integer",
          "minimum": 0
        },
        "changed_evidence_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/digest"
          }
        },
        "changed_evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/digest"
          }
        },
        "input_checked": {
          "type": "boolean"
        },
        "input_changed": {
          "type": "boolean"
        },
        "output_checked": {
          "type": "boolean"
        },
        "output_changed": {
          "type": "boolean"
        },
        "model_present": {
          "type": "boolean"
        },
        "policy_present": {
          "type": "boolean"
        },
        "input_present": {
          "type": "boolean"
        },
        "output_present": {
          "type": "boolean"
        },
        "manifest_hash_valid": {
          "type": "boolean"
        },
        "record_hash_valid": {
          "type": "boolean"
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
          }
        }
      },
      "required": [
        "changed_evidence_count",
        "changed_evidence_ids",
        "input_changed",
        "input_checked",
        "input_present",
        "manifest_hash_valid",
        "missing_evidence_count",
        "missing_evidence_ids",
        "model_present",
        "output_changed",
        "output_checked",
        "output_present",
        "policy_present",
        "reason_codes",
        "record_hash_valid"
      ]
    },
    "guarded_provenance": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {},
          "required": []
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": 1
            },
            "record_type": {
              "const": "openmed.clinical.guarded_output_provenance"
            },
            "record_id": {
              "$ref": "#/$defs/digest"
            },
            "output_kind": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
            },
            "input_hash": {
              "anyOf": [
                {
                  "$ref": "#/$defs/digest"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output_hash": {
              "anyOf": [
                {
                  "$ref": "#/$defs/digest"
                },
                {
                  "type": "null"
                }
              ]
            },
            "model": {
              "$ref": "#/$defs/guarded_model"
            },
            "policy_fingerprint": {
              "anyOf": [
                {
                  "$ref": "#/$defs/digest"
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/digest"
              }
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/guarded_evidence"
              }
            },
            "review": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "required": {
                  "type": "boolean"
                },
                "status": {
                  "enum": [
                    "abstained",
                    "approved",
                    "in_review",
                    "needs_revision",
                    "queued",
                    "rejected",
                    "reopened"
                  ]
                },
                "transitions": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/guarded_transition"
                  }
                }
              },
              "required": [
                "required",
                "status",
                "transitions"
              ]
            },
            "review_required": {
              "type": "boolean"
            },
            "review_status": {
              "enum": [
                "abstained",
                "approved",
                "in_review",
                "needs_revision",
                "queued",
                "rejected",
                "reopened"
              ]
            },
            "review_transitions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/guarded_transition"
              }
            },
            "integrity": {
              "$ref": "#/$defs/guarded_integrity"
            },
            "record_hash": {
              "$ref": "#/$defs/digest"
            },
            "disclaimer": {
              "const": "Guarded clinical-output provenance is value-free assistive metadata for human review; it is not a clinical decision, compliance certification, diagnosis, or treatment recommendation."
            }
          },
          "required": [
            "disclaimer",
            "evidence",
            "evidence_ids",
            "input_hash",
            "integrity",
            "model",
            "output_hash",
            "output_kind",
            "policy_fingerprint",
            "record_hash",
            "record_id",
            "record_type",
            "review",
            "review_required",
            "review_status",
            "review_transitions",
            "schema_version"
          ]
        }
      ]
    },
    "envelope_provenance": {
      "type": "object",
      "propertyNames": {
        "allOf": [
          {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
          },
          {
            "not": {
              "enum": [
                "address",
                "date",
                "deidentified_text",
                "email",
                "entities",
                "mapping",
                "name",
                "original",
                "original_text",
                "path",
                "phone",
                "pii_entities",
                "raw",
                "source_path",
                "source_text",
                "text",
                "value"
              ]
            }
          }
        ]
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "review_metadata_string": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:hash:)?sha256:[0-9a-f]{64}$"
        },
        {
          "enum": [
            "[PROTECTED_TEXT_OMITTED]",
            "approved",
            "blocked",
            "blocking",
            "claim",
            "condition",
            "critical",
            "deferred",
            "entity",
            "error",
            "failed",
            "finding",
            "high",
            "info",
            "lab_result",
            "low",
            "measurement",
            "medication",
            "medication_review",
            "needs_review",
            "normal",
            "not_evaluated",
            "ok",
            "passed",
            "procedure",
            "protected",
            "provided",
            "ready_for_review",
            "rejected",
            "relation",
            "renal_function_measure",
            "requires_review",
            "review_required",
            "source",
            "synthetic_finding",
            "uncertain",
            "unknown",
            "unspecified",
            "unsupported",
            "warning"
          ]
        }
      ]
    },
    "review_metadata_value": {
      "anyOf": [
        {
          "$ref": "#/$defs/review_metadata_string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/review_metadata"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/review_metadata_value"
          }
        }
      ]
    },
    "review_metadata": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[cC][aA][tT][eE][gG][oO][rR][yY]$": {
          "$ref": "#/$defs/review_metadata_value"
        },
        "^[cC][lL][aA][sS][sS]$": {
          "$ref": "#/$defs/review_metadata_value"
        },
        "^[cC][oO][dD][eE]$": {
          "$ref": "#/$defs/review_metadata_value"
        },
        "^[cC][oO][nN][fF][iI][dD][eE][nN][cC][eE]$": {
          "anyOf": [
            {
              "$ref": "#/$defs/review_metadata_value"
            },
            {
              "type": "number"
            }
          ]
        },
        "^[cC][oO][uU][nN][tT]$": {
          "anyOf": [
            {
              "$ref": "#/$defs/review_metadata_value"
            },
            {
              "type": "number"
            }
          ]
        },
        "^[dD][iI][rR][eE][cC][tT][iI][oO][nN]$": {
          "$ref": "#/$defs/review_metadata_value"
        },
        "^[fF][oO][rR][mM][aA][tT]$": {
