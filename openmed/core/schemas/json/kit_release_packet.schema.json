{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmed.dev/schemas/kit_release_packet.schema.json",
  "title": "OpenMed v4.0 portable-kit release evidence packet",
  "description": "Signed, value-free v4.0 OpenMedKit release decision. It carries controlled codes, counts, matrix identifiers and digests only: no paths, file contents, device identifiers, free text or key material.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "compatibility_policy", "release", "decision",
    "repository_binding", "evidence", "evidence_kinds", "supported_cells",
    "surfaces", "moved_items", "blocking_codes", "limitations",
    "manifest_digest", "reproduction", "packet_digest", "signature"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "compatibility_policy": {"const": "same_major"},
    "release": {
      "type": "object", "additionalProperties": false,
      "required": [
        "version", "matrix_release", "candidate_commit", "evaluated_at",
        "source_date_epoch"
      ],
      "properties": {
        "version": {"type": "string", "maxLength": 48},
        "matrix_release": {"type": "string", "pattern": "^v[0-9]{1,3}\\.[0-9]{1,3}$"},
        "candidate_commit": {"$ref": "#/$defs/commit"},
        "evaluated_at": {"$ref": "#/$defs/timestamp"},
        "source_date_epoch": {"type": "integer", "minimum": 0}
      }
    },
    "decision": {"enum": ["READY", "NOT_READY"]},
    "repository_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["verified", "head_commit", "blocking_codes"],
      "properties": {
        "verified": {"type": "boolean"},
        "head_commit": {"$ref": "#/$defs/commit"},
        "blocking_codes": {"$ref": "#/$defs/code_array"}
      }
    },
    "evidence": {
      "type": "array", "maxItems": 512,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "id", "kind", "state", "digest", "byte_size", "candidate_commit",
          "age_seconds", "loader", "attributes", "summary", "blocking_codes"
        ],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "kind": {"$ref": "#/$defs/kind"},
          "state": {"enum": ["verified", "blocked"]},
          "digest": {"$ref": "#/$defs/digest"},
          "byte_size": {"type": "integer", "minimum": 0},
          "candidate_commit": {"$ref": "#/$defs/commit"},
          "age_seconds": {"type": "integer", "minimum": 0},
          "loader": {"enum": ["typed", "digest_only"]},
          "attributes": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "surface": {"$ref": "#/$defs/surface"},
              "format": {
                "enum": [
                  "aar", "electron-package", "flutter-package", "npm-tarball",
                  "python-sdist", "python-wheel", "swiftpm-source", "tauri-crate"
                ]
              }
            }
          },
          "summary": {
            "type": "object",
            "maxProperties": 64,
            "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
            "additionalProperties": {
              "anyOf": [
                {"type": "boolean"},
                {"type": "integer", "minimum": 0},
                {"$ref": "#/$defs/digest"},
                {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"}
              ]
            }
          },
          "blocking_codes": {"$ref": "#/$defs/code_array"}
        }
      }
    },
    "evidence_kinds": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "required", "state", "entry_count", "blocking_codes"],
        "properties": {
          "kind": {"$ref": "#/$defs/kind"},
          "required": {"type": "boolean"},
          "state": {"enum": ["present", "not_present", "blocked"]},
          "entry_count": {"type": "integer", "minimum": 0},
          "blocking_codes": {"$ref": "#/$defs/code_array"}
        }
      }
    },
    "supported_cells": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "cell", "surface", "runtime_kind", "qualification", "lane_count",
          "blocking_codes"
        ],
        "properties": {
          "cell": {"$ref": "#/$defs/id"},
          "surface": {"$ref": "#/$defs/surface"},
          "runtime_kind": {"enum": ["inference", "ocr", "keystore"]},
          "qualification": {"$ref": "#/$defs/code"},
          "lane_count": {"type": "integer", "minimum": 0},
          "blocking_codes": {"$ref": "#/$defs/code_array"}
        }
      }
    },
    "surfaces": {
      "type": "array", "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "surface", "support_claim", "artifact_count", "artifact_required",
          "blocking_codes"
        ],
        "properties": {
          "surface": {"$ref": "#/$defs/surface"},
          "support_claim": {"enum": ["supported", "experimental-only", "unverified"]},
          "artifact_count": {"type": "integer", "minimum": 0},
          "artifact_required": {"type": "boolean"},
          "blocking_codes": {"$ref": "#/$defs/code_array"}
        }
      }
    },
    "moved_items": {
      "type": "array", "maxItems": 512,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "issue", "priority", "destination", "rationale", "narrowed_claims",
          "blocking_codes"
        ],
        "properties": {
          "issue": {"type": "string", "pattern": "^#[1-9][0-9]{0,6}$"},
          "priority": {"enum": ["P0", "P1", "P2"]},
          "destination": {
            "anyOf": [
              {"type": "null"},
              {"type": "string", "pattern": "^(#[1-9][0-9]{0,6}|v[0-9]{1,3}\\.[0-9]{1,3}(\\.[0-9]{1,3})?)$"}
            ]
          },
          "rationale": {
            "enum": [
              null, "blocked_by_dependency", "evidence_incomplete",
              "hardware_unavailable", "out_of_scope", "risk_not_accepted",
              "toolchain_unavailable", "upstream_unreleased"
            ]
          },
          "narrowed_claims": {
            "type": "array", "uniqueItems": true,
            "items": {"$ref": "#/$defs/id"}
          },
          "blocking_codes": {"$ref": "#/$defs/code_array"}
        }
      }
    },
    "blocking_codes": {"$ref": "#/$defs/code_array"},
    "limitations": {
      "type": "array", "uniqueItems": true,
      "items": {
        "enum": [
          "no_autonomous_clinical_action", "no_publication_authorization",
          "not_a_medical_device", "not_clinically_validated",
          "requires_local_validation"
        ]
      }
    },
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "reproduction": {
      "type": "object", "additionalProperties": false,
      "required": ["command", "evidence_count", "moved_item_count"],
      "properties": {
        "command": {"type": "string", "maxLength": 160},
        "evidence_count": {"type": "integer", "minimum": 0},
        "moved_item_count": {"type": "integer", "minimum": 0}
      }
    },
    "packet_digest": {"$ref": "#/$defs/digest"},
    "signature": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["key_id", "algorithm", "value"],
          "properties": {
            "key_id": {"$ref": "#/$defs/code"},
            "algorithm": {"const": "HMAC-SHA256"},
            "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      ]
    }
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "code": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:#-]{0,159}$"},
    "code_array": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/code"}
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "kind": {
      "enum": [
        "kit_artifact", "support_matrix", "qualification_report",
        "bundle_manifest", "parity_fixture", "license_inventory",
        "threat_model", "test_lane"
      ]
    },
    "surface": {
      "enum": [
        "python", "swift", "android", "react-native", "web",
        "document-intake", "key-store", "flutter", "electron", "tauri"
      ]
    }
  }
}
