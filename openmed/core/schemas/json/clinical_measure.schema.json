{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmed.dev/schemas/v3/clinical/measure.schema.json",
  "title": "OpenMed clinical measure artifacts",
  "schema_version": "1.0.0",
  "oneOf": [
    {"$ref": "#/$defs/definition"},
    {"$ref": "#/$defs/subject_result"}
  ],
  "$defs": {
    "controlled": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:/-]{0,127}$"
    },
    "opaque_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}_[A-Za-z0-9_-]{16,128}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {"type": "string", "format": "date-time"},
    "time_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["end", "start"],
      "properties": {
        "end": {"$ref": "#/$defs/timestamp"},
        "start": {"$ref": "#/$defs/timestamp"}
      }
    },
    "population_kind": {
      "enum": [
        "denominator",
        "denominator_exception",
        "denominator_exclusion",
        "initial_population",
        "measure_observation",
        "numerator"
      ]
    },
    "population_state": {"enum": ["error", "met", "not_met", "unknown"]},
    "population_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression_ref", "kind", "population_id"],
      "properties": {
        "expression_ref": {"$ref": "#/$defs/controlled"},
        "kind": {"$ref": "#/$defs/population_kind"},
        "population_id": {"$ref": "#/$defs/controlled"}
      }
    },
    "value_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "value_set_id", "version"],
      "properties": {
        "digest": {"$ref": "#/$defs/digest"},
        "value_set_id": {"$ref": "#/$defs/controlled"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compatibility_policy",
        "language",
        "library_digest",
        "library_id",
        "measure_id",
        "populations",
        "schema_version",
        "value_sets",
        "version"
      ],
      "properties": {
        "compatibility_policy": {"const": "same_major"},
        "language": {"enum": ["elm_json", "native"]},
        "library_digest": {
          "anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
        },
        "library_id": {
          "anyOf": [{"$ref": "#/$defs/controlled"}, {"type": "null"}]
        },
        "measure_id": {"$ref": "#/$defs/opaque_id"},
        "populations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/population_definition"}
        },
        "schema_version": {"const": "1.0.0"},
        "value_sets": {
          "type": "array",
          "items": {"$ref": "#/$defs/value_set"}
        },
        "version": {
          "type": "string",
          "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_digest", "engine_id", "execution_mode", "version"],
      "properties": {
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "engine_id": {"$ref": "#/$defs/controlled"},
        "execution_mode": {"enum": ["native", "service", "subprocess"]},
        "version": {
          "type": "string",
          "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["derivation_digests", "evidence_ids", "fact_ids"],
      "properties": {
        "derivation_digests": {
          "type": "array",
          "items": {"$ref": "#/$defs/digest"}
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/opaque_id"}
        },
        "fact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/opaque_id"}
        }
      }
    },
    "population_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error_code",
        "evidence",
        "kind",
        "population_id",
        "reason_code",
        "state"
      ],
      "properties": {
        "error_code": {
          "anyOf": [{"$ref": "#/$defs/controlled"}, {"type": "null"}]
        },
        "evidence": {"$ref": "#/$defs/evidence"},
        "kind": {"$ref": "#/$defs/population_kind"},
        "population_id": {"$ref": "#/$defs/controlled"},
        "reason_code": {"$ref": "#/$defs/controlled"},
        "state": {"$ref": "#/$defs/population_state"}
      }
    },
    "trace_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_digest",
        "expression_ref",
        "input_digest",
        "reason_code",
        "state",
        "step_id"
      ],
      "properties": {
        "evidence_digest": {"$ref": "#/$defs/digest"},
        "expression_ref": {"$ref": "#/$defs/controlled"},
        "input_digest": {"$ref": "#/$defs/digest"},
        "reason_code": {"$ref": "#/$defs/controlled"},
        "state": {"$ref": "#/$defs/population_state"},
        "step_id": {"$ref": "#/$defs/controlled"}
      }
    },
    "subject_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advisory",
        "artifact_type",
        "compatibility_policy",
        "definition_digest",
        "definition_version_id",
        "engine",
        "evaluated_at",
        "input_projection_digest",
        "measurement_period",
        "populations",
        "result_digest",
        "result_id",
        "schema_version",
        "source_snapshot_digest",
        "source_snapshot_id",
        "subject_id",
        "trace",
        "value_set_digests"
      ],
      "properties": {
        "advisory": {
          "const": "Measure output is deterministic decision-support evidence for governed review; it is not a diagnosis, treatment, order, outreach, or payment action."
        },
        "artifact_type": {"const": "measure_subject_result"},
        "compatibility_policy": {"const": "same_major"},
        "definition_digest": {"$ref": "#/$defs/digest"},
        "definition_version_id": {"$ref": "#/$defs/opaque_id"},
        "engine": {"$ref": "#/$defs/engine"},
        "evaluated_at": {"$ref": "#/$defs/timestamp"},
        "input_projection_digest": {"$ref": "#/$defs/digest"},
        "measurement_period": {"$ref": "#/$defs/time_window"},
        "populations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/population_result"}
        },
        "result_digest": {"$ref": "#/$defs/digest"},
        "result_id": {"$ref": "#/$defs/opaque_id"},
        "schema_version": {"const": "1.0.0"},
        "source_snapshot_digest": {"$ref": "#/$defs/digest"},
        "source_snapshot_id": {"$ref": "#/$defs/opaque_id"},
        "subject_id": {"$ref": "#/$defs/opaque_id"},
        "trace": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/trace_step"}
        },
        "value_set_digests": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/controlled"},
          "additionalProperties": {"$ref": "#/$defs/digest"}
        }
      }
    }
  }
}
