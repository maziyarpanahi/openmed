{
  "$id": "https://openmed.dev/schemas/v3/ingestion/cancellation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "cancellation_id": {"pattern": "^[a-z][a-z0-9_]{0,31}_[A-Za-z0-9_-]{16,128}$", "type": "string"},
    "job_id": {"pattern": "^[a-z][a-z0-9_]{0,31}_[A-Za-z0-9_-]{16,128}$", "type": "string"},
    "reason_code": {"pattern": "^[a-z][a-z0-9_.:/-]{0,127}$", "type": "string"},
    "requested_at": {"format": "date-time", "type": "string"},
    "schema_version": {"const": "1.0.0"}
  },
  "required": ["actor_digest", "cancellation_id", "job_id", "reason_code", "requested_at", "schema_version"],
  "schema_version": 1,
  "title": "OpenMedIngestionCancellation",
  "type": "object"
}
