{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmed.life/schemas/task_pack.schema.json",
  "title": "OpenMed portable task pack manifest",
  "description": "Generated by scripts/manifest/build_task_packs.py from models.jsonl. Each pack names a job, its canonical labels, its selection rules and its ordered model candidates per runtime. #/$defs/task_pack validates one pack on its own. Readers reject other major versions and undeclared fields; an optional field bumps the minor version and a new required field or a changed meaning bumps the major version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["notices", "packs", "schema", "schema_version", "source"],
  "properties": {
    "schema": {"const": "openmed.task_packs"},
    "schema_version": {"type": "string", "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "source": {"const": "models.jsonl"},
    "notices": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/notice_key"},
      "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/task_pack"}
    }
  },
  "$defs": {
    "notice_key": {"type": "string", "pattern": "^openmed\\.notice\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"},
    "label": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
    "license": {
      "enum": ["apache-2.0", "bsd-2-clause", "bsd-3-clause", "cc-by-4.0", "cc0-1.0", "isc", "mit", "unlicense"]
    },
    "task_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_labels", "notice_key", "pack_id", "runtimes", "selection", "task", "version"],
      "properties": {
        "pack_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "task": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        "canonical_labels": {
          "description": "Labels every candidate is guaranteed to emit. Candidates may emit more.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/label"}
        },
        "notice_key": {"$ref": "#/$defs/notice_key"},
        "selection": {"$ref": "#/$defs/selection"},
        "runtimes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["android", "apple", "web"],
          "properties": {
            "android": {"$ref": "#/$defs/runtime_onnx"},
            "apple": {"$ref": "#/$defs/runtime_mlx"},
            "web": {"$ref": "#/$defs/runtime_onnx"}
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "family_token",
        "label_coverage",
        "languages",
        "licenses",
        "manifest_task",
        "max_candidates",
        "max_param_count",
        "order"
      ],
      "properties": {
        "family": {"type": "string", "minLength": 1, "maxLength": 64},
        "family_token": {"oneOf": [{"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]{0,63}$"}, {"type": "null"}]},
        "label_coverage": {"const": "all"},
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z]{2,3}$"}
        },
        "licenses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/license"}
        },
        "manifest_task": {"type": "string", "minLength": 1, "maxLength": 64},
        "max_candidates": {"type": "integer", "minimum": 1, "maximum": 16},
        "max_param_count": {"type": "integer", "minimum": 1},
        "order": {"const": "param_count_asc_repo_id_asc"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["license", "param_count", "rank", "repo_id"],
      "properties": {
        "license": {"$ref": "#/$defs/license"},
        "param_count": {"type": "integer", "minimum": 1},
        "rank": {"type": "integer", "minimum": 1},
        "repo_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}/[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"}
      }
    },
    "runtime_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidates", "format", "status"],
      "properties": {
        "candidates": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/candidate"}},
        "format": {"enum": ["mlx-fp", "onnx"]},
        "status": {"enum": ["no_candidate", "resolved"]}
      },
      "oneOf": [
        {
          "properties": {"status": {"const": "resolved"}, "candidates": {"minItems": 1}}
        },
        {
          "properties": {"status": {"const": "no_candidate"}, "candidates": {"maxItems": 0}}
        }
      ]
    },
    "runtime_mlx": {
      "allOf": [{"$ref": "#/$defs/runtime_entry"}, {"properties": {"format": {"const": "mlx-fp"}}}]
    },
    "runtime_onnx": {
      "allOf": [{"$ref": "#/$defs/runtime_entry"}, {"properties": {"format": {"const": "onnx"}}}]
    }
  }
}
