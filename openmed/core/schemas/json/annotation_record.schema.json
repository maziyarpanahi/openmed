{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmed.dev/schemas/annotation-record/1.0.0",
  "title": "OpenMed Annotation Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "annotation_id",
    "annotation_type",
    "compatibility_policy",
    "coordinate_convention",
    "document_id",
    "embedding",
    "end",
    "metadata",
    "namespace",
    "result",
    "schema_version",
    "start",
    "state"
  ],
  "properties": {
    "annotation_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}_[A-Za-z0-9_-]{8,128}$"},
    "annotation_type": {"enum": ["entity", "relation", "fact_correction", "registry_label"]},
    "compatibility_policy": {"const": "same_major"},
    "coordinate_convention": {"enum": ["unicode_codepoint", "utf8_byte", "utf16_code_unit", "token_index", "none"]},
    "document_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}_[A-Za-z0-9_-]{8,128}$"},
    "embedding": {
      "oneOf": [
        {"type": "null"},
        {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"type": "number"}}
      ]
    },
    "end": {"type": ["integer", "null"], "minimum": 1},
    "metadata": {"type": "object", "maxProperties": 6},
    "namespace": {"type": "string", "pattern": "^[a-z][a-z0-9_.:/-]{0,127}$"},
    "result": {"type": "object", "minProperties": 2, "maxProperties": 5},
    "schema_version": {"const": "1.0.0"},
    "start": {"type": ["integer", "null"], "minimum": 0},
    "state": {"enum": ["success", "partial", "unknown", "conflict", "unsupported", "denied", "failure"]}
  }
}
