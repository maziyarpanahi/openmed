{
  "$id": "https://openmed.dev/schemas/v1/service_job_record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "completed_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "digests": {
      "additionalProperties": false,
      "description": "How span, document and webhook URL digests were produced.",
      "properties": {
        "alg": {
          "type": [
            "string",
            "null"
          ]
        },
        "key_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "enum": [
            "keyed",
            "omitted"
          ],
          "type": "string"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "mode",
        "alg",
        "key_id",
        "reason"
      ],
      "type": "object"
    },
    "document_count": {
      "minimum": 0,
      "type": "integer"
    },
    "documents": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "length": {
            "minimum": 0,
            "type": "integer"
          },
          "text_digest": {
            "additionalProperties": false,
            "properties": {
              "alg": {
                "const": "hmac-sha256",
                "type": "string"
              },
              "key_id": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
                "type": "string"
              },
              "value": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "alg",
              "key_id",
              "value"
            ],
            "type": [
              "object",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "length",
          "text_digest"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "type": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "type",
        "message"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "expires_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "failed_count": {
      "minimum": 0,
      "type": "integer"
    },
    "id": {
      "pattern": "^[0-9a-f]{32}$",
      "type": "string"
    },
    "label_histogram": {
      "additionalProperties": {
        "minimum": 0,
        "type": "integer"
      },
      "type": "object"
    },
    "payloads": {
      "additionalProperties": false,
      "description": "Opaque payload references and their lifecycle; never payload content.",
      "properties": {
        "input": {
          "additionalProperties": false,
          "properties": {
            "created_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "digest": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": [
                "string",
                "null"
              ]
            },
            "expires_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "ref": {
              "pattern": "^jp_[0-9a-f]{32}$",
              "type": "string"
            },
            "schema_version": {
              "minimum": 1,
              "type": "integer"
            },
            "state": {
              "enum": [
                "retained",
                "deleted",
                "expired"
              ],
              "type": "string"
            }
          },
          "required": [
            "ref",
            "schema_version",
            "state"
          ],
          "type": [
            "object",
            "null"
          ]
        },
        "mode": {
          "enum": [
            "memory",
            "encrypted"
          ],
          "type": "string"
        },
        "retention_seconds": {
          "minimum": 0,
          "type": "integer"
        },
        "schema_version": {
          "minimum": 1,
          "type": "integer"
        },
        "terminal_event": {
          "additionalProperties": false,
          "properties": {
            "created_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "digest": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": [
                "string",
                "null"
              ]
            },
            "expires_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "ref": {
              "pattern": "^jp_[0-9a-f]{32}$",
              "type": "string"
            },
            "schema_version": {
              "minimum": 1,
              "type": "integer"
            },
            "state": {
              "enum": [
                "retained",
                "deleted",
                "expired"
              ],
              "type": "string"
            }
          },
          "required": [
            "ref",
            "schema_version",
            "state"
          ],
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "schema_version",
        "mode",
        "retention_seconds",
        "input",
        "terminal_event"
      ],
      "type": "object"
    },
    "processed_count": {
      "minimum": 0,
      "type": "integer"
    },
    "progress_percent": {
      "maximum": 100,
      "minimum": 0,
      "type": "number"
    },
    "recovery": {
      "additionalProperties": false,
      "description": "Value-free durable recovery state; never worker, lease or request identity.",
      "properties": {
        "attempt": {
          "minimum": 0,
          "type": "integer"
        },
        "checkpoint": {
          "additionalProperties": false,
          "properties": {
            "completed_at": {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
              "type": "string"
            },
            "sequence": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "completed_at",
            "sequence"
          ],
          "type": [
            "object",
            "null"
          ]
        },
        "completed_documents": {
          "minimum": 0,
          "type": "integer"
        },
        "execution": {
          "minimum": 1,
          "type": "integer"
        },
        "lease": {
          "additionalProperties": false,
          "properties": {
            "acquired_at": {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
              "type": "string"
            },
            "epoch": {
              "minimum": 1,
              "type": "integer"
            },
            "expires_at": {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
              "type": "string"
            }
          },
          "required": [
            "acquired_at",
            "epoch",
            "expires_at"
          ],
          "type": [
            "object",
            "null"
          ]
        },
        "lease_epoch": {
          "minimum": 0,
          "type": "integer"
        },
        "max_attempts": {
          "minimum": 1,
          "type": "integer"
        },
        "quarantine": {
          "additionalProperties": false,
          "properties": {
            "classification": {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            },
            "created_at": {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
              "type": "string"
            },
            "quarantine_id": {
              "pattern": "^quarantine_[0-9a-f]{32}$",
              "type": "string"
            },
            "reason_code": {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            }
          },
          "required": [
            "classification",
            "created_at",
            "quarantine_id",
            "reason_code"
          ],
          "type": [
            "object",
            "null"
          ]
        },
        "retry": {
          "additionalProperties": false,
          "properties": {
            "attempt": {
              "minimum": 1,
              "type": "integer"
            },
            "classification": {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            },
            "reason_code": {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            },
            "retry_after": {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
              "type": "string"
            }
          },
          "required": [
            "attempt",
            "classification",
            "reason_code",
            "retry_after"
          ],
          "type": [
            "object",
            "null"
          ]
        },
        "schema_version": {
          "minimum": 1,
          "type": "integer"
        },
        "transitions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "at": {
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
                "type": "string"
              },
              "attempt": {
                "minimum": 0,
                "type": "integer"
              },
              "execution": {
                "minimum": 1,
                "type": "integer"
              },
              "from": {
                "enum": [
                  "queued",
                  "running",
                  "done",
                  "failed",
                  "cancelled",
                  "quarantined",
                  null
                ],
                "type": [
                  "string",
                  "null"
                ]
              },
              "lease_epoch": {
                "minimum": 0,
                "type": "integer"
              },
              "reason": {
                "pattern": "^[a-z][a-z0-9_]{0,63}$",
                "type": "string"
              },
              "state_version": {
                "minimum": 1,
                "type": "integer"
              },
              "to": {
                "enum": [
                  "queued",
                  "running",
                  "done",
                  "failed",
                  "cancelled",
                  "quarantined"
                ],
                "type": "string"
              }
            },
            "required": [
              "state_version",
              "from",
              "to",
              "reason",
              "at",
              "execution",
              "attempt",
              "lease_epoch"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "webhook": {
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "pending",
                "delivered",
                "failed",
                "unavailable"
              ],
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "schema_version",
        "execution",
        "attempt",
        "max_attempts",
        "lease_epoch",
        "lease",
        "checkpoint",
        "completed_documents",
        "retry",
        "quarantine",
        "webhook",
        "transitions"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "spans": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "confidence": {
            "maximum": 1,
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "document_id": {
            "minLength": 1,
            "type": "string"
          },
          "end": {
            "minimum": 0,
            "type": "integer"
          },
          "label": {
            "minLength": 1,
            "type": "string"
          },
          "start": {
            "minimum": 0,
            "type": "integer"
          },
          "text_digest": {
            "additionalProperties": false,
            "properties": {
              "alg": {
                "const": "hmac-sha256",
                "type": "string"
              },
              "key_id": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
                "type": "string"
              },
              "value": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "alg",
              "key_id",
              "value"
            ],
            "type": [
              "object",
              "null"
            ]
          }
        },
        "required": [
          "document_id",
          "start",
          "end",
          "label",
          "text_digest",
          "confidence"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "started_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": [
        "string",
        "null"
      ]
    },
    "state_version": {
      "description": "Incremented by every committed write of the record.",
      "minimum": 1,
      "type": "integer"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "done",
        "failed",
        "cancelled",
        "quarantined"
      ],
      "type": "string"
    },
    "status_url": {
      "minLength": 1,
      "type": "string"
    },
    "updated_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "webhook": {
      "additionalProperties": false,
      "properties": {
        "backoff_seconds": {
          "maximum": 60,
          "minimum": 0,
          "type": "number"
        },
        "configured": {
          "const": true,
          "type": "boolean"
        },
        "max_attempts": {
          "maximum": 10,
          "minimum": 1,
          "type": "integer"
        },
        "url_digest": {
          "additionalProperties": false,
          "properties": {
            "alg": {
              "const": "hmac-sha256",
              "type": "string"
            },
            "key_id": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
              "type": "string"
            },
            "value": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "alg",
            "key_id",
            "value"
          ],
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "configured",
        "url_digest",
        "max_attempts",
        "backoff_seconds"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "webhook_delivery": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "minimum": 0,
          "type": "integer"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "payload_ref": {
          "pattern": "^jp_[0-9a-f]{32}$",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "pending",
            "delivered",
            "failed",
            "abandoned"
          ],
          "type": "string"
        },
        "status_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "success": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "success",
        "attempts",
        "status_code",
        "error"
      ],
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "status",
    "progress_percent",
    "document_count",
    "processed_count",
    "failed_count",
    "label_histogram",
    "spans",
    "documents",
    "error",
    "webhook",
    "webhook_delivery",
    "created_at",
    "updated_at",
    "started_at",
    "completed_at",
    "expires_at"
  ],
  "schema_version": 1,
  "title": "OpenMedServiceJobRecord",
  "type": "object"
}
