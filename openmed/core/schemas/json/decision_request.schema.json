{
  "$id": "https://openmed.dev/schemas/decision-request/1.1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "scalar_score"
          }
        }
      },
      "then": {
        "properties": {
          "options": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "boolean_choice"
          }
        }
      },
      "then": {
        "properties": {
          "options": {
            "maxItems": 2,
            "minItems": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "enum": [
              "fixed_choice",
              "ordered_preference",
              "multi_label"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "options": {
            "maxItems": 64,
            "minItems": 2
          }
        }
      }
    },
    {
      "else": {
        "not": {
          "required": [
            "levels"
          ]
        }
      },
      "if": {
        "properties": {
          "mode": {
            "const": "scalar_score"
          }
        }
      }
    },
    {
      "else": {
        "not": {
          "required": [
            "questions"
          ]
        }
      },
      "if": {
        "properties": {
          "mode": {
            "const": "question_set"
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "question_id"
              ]
            },
            {
              "required": [
                "instructions"
              ]
            },
            {
              "required": [
                "option_descriptions"
              ]
            },
            {
              "required": [
                "levels"
              ]
            }
          ]
        },
        "properties": {
          "options": {
            "maxItems": 0
          }
        },
        "required": [
          "questions"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.0.0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "question_id"
              ]
            },
            {
              "required": [
                "instructions"
              ]
            },
            {
              "required": [
                "option_descriptions"
              ]
            },
            {
              "required": [
                "levels"
              ]
            },
            {
              "required": [
                "questions"
              ]
            },
            {
              "required": [
                "input_format"
              ]
            },
            {
              "required": [
                "max_input_chars"
              ]
            }
          ]
        },
        "properties": {
          "mode": {
            "not": {
              "const": "question_set"
            }
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "required": [
            "max_input_chars"
          ]
        }
      },
      "then": {
        "properties": {
          "input_text": {
            "maxLength": 8192
          }
        }
      }
    }
  ],
  "properties": {
    "calibration_id": {
      "default": "openmed.synthetic.fixed_option.v1",
      "pattern": "^[a-z][a-z0-9_.:/-]{0,127}$",
      "type": "string"
    },
    "compatibility_policy": {
      "const": "same_major",
      "default": "same_major",
      "type": "string"
    },
    "input_format": {
      "default": "text",
      "enum": [
        "text",
        "json"
      ],
      "type": "string"
    },
    "input_text": {
      "maxLength": 131072,
      "minLength": 1,
      "type": "string"
    },
    "instructions": {
      "anyOf": [
        {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional question wording passed to the backend."
    },
    "levels": {
      "description": "Ordered scalar_score levels, lowest first.",
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 2,
      "type": "array"
    },
    "max_input_chars": {
      "description": "Input character bound; 8192 when omitted.",
      "maximum": 131072,
      "minimum": 1,
      "type": "integer"
    },
    "mode": {
      "enum": [
        "fixed_choice",
        "boolean_choice",
        "ordered_preference",
        "scalar_score",
        "multi_label",
        "question_set"
      ],
      "type": "string"
    },
    "namespace": {
      "default": "default",
      "pattern": "^[a-z][a-z0-9_.:/-]{0,127}$",
      "type": "string"
    },
    "option_descriptions": {
      "description": "Optional descriptions aligned with options; null marks an option without a description.",
      "items": {
        "anyOf": [
          {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "maxItems": 64,
      "type": "array"
    },
    "options": {
      "default": [],
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "type": "array"
    },
    "purpose": {
      "default": "care_review",
      "pattern": "^[a-z][a-z0-9_.:/-]{0,127}$",
      "type": "string"
    },
    "question_id": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,63}$",
      "type": "string"
    },
    "questions": {
      "description": "Named questions scored against the one input.",
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "scalar_score"
                }
              }
            },
            "then": {
              "properties": {
                "options": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "boolean_choice"
                }
              }
            },
            "then": {
              "properties": {
                "options": {
                  "maxItems": 2,
                  "minItems": 2
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "mode": {
                  "enum": [
                    "fixed_choice",
                    "ordered_preference",
                    "multi_label"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "options": {
                  "maxItems": 64,
                  "minItems": 2
                }
              }
            }
          },
          {
            "else": {
              "not": {
                "required": [
                  "levels"
                ]
              }
            },
            "if": {
              "properties": {
                "mode": {
                  "const": "scalar_score"
                }
              }
            }
          }
        ],
        "properties": {
          "instructions": {
            "anyOf": [
              {
                "maxLength": 2048,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional question wording passed to the backend."
          },
          "levels": {
            "description": "Ordered scalar_score levels, lowest first.",
            "items": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 64,
            "minItems": 2,
            "type": "array"
          },
          "mode": {
            "enum": [
              "fixed_choice",
              "boolean_choice",
              "ordered_preference",
              "scalar_score",
              "multi_label"
            ],
            "type": "string"
          },
          "option_descriptions": {
            "description": "Optional descriptions aligned with options; null marks an option without a description.",
            "items": {
              "anyOf": [
                {
                  "maxLength": 1024,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "maxItems": 64,
            "type": "array"
          },
          "options": {
            "default": [],
            "items": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 64,
            "type": "array"
          },
          "question_id": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,63}$",
            "type": "string"
          }
        },
        "required": [
          "question_id",
          "mode"
        ],
        "type": "object"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "description": "Omitted, it resolves to 1.1.0 when a 1.1.0 field is present and to 1.0.0 otherwise.",
      "enum": [
        "1.0.0",
        "1.1.0"
      ],
      "type": "string"
    },
    "timeout_ms": {
      "default": 5000,
      "maximum": 30000,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "mode",
    "input_text"
  ],
  "title": "OpenMed Fixed-Option Decision Request",
  "type": "object"
}
