{
  "$defs": {
    "evidence": {
      "additionalProperties": false,
      "properties": {
        "candidate_key": {"pattern": "^[a-z][a-z0-9_]{0,31}_[A-Za-z0-9_-]{16,128}$", "type": "string"},
        "evidence_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
        "evidence_id": {"pattern": "^[a-z][a-z0-9_]{0,31}_[A-Za-z0-9_-]{16,128}$", "type": "string"},
        "evidence_type": {"pattern": "^[a-z][a-z0-9_.:/-]{0,127}$", "type": "string"},
        "method": {"enum": ["exact", "probabilistic"]},
        "policy_id": {"pattern": "^[a-z][a-z0-9_.:/-]{0,127}$", "type": "string"},
        "policy_version": {"pattern": "^[1-9][0-9]*(\\.[0-9]+){0,2}$", "type": "string"},
        "schema_version": {"const": "1.0.0"},
        "source_key_fingerprint": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"}
      },
      "required": ["candidate_key", "evidence_digest", "evidence_id", "evidence_type", "method", "policy_id", "policy_version", "schema_version", "source_key_fingerprint"],
      "type": "object"
    },
    "sourceKey": {
      "additionalProperties": false,
      "properties": {
        "entity_type": {"enum": ["patient", "encounter"]},
        "local_key": {"pattern": "^[a-z][a-z0-9_]{0,31}_[A-Za-z0-9_-]{16,128}$", "type": "string"},
        "schema_version": {"const": "1.0.0"},
        "source_id": {"pattern": "^[a-z][a-z0-9_]{0,31}_[A-Za-z0-9_-]{16,128}$", "type": "string"}
      },
      "required": ["entity_type", "local_key", "schema_version", "source_id"],
      "type": "object"
    }
  },
  "$id": "https://openmed.dev/schemas/v3/identity/resolution.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_keys": {"items": {"pattern": "^[a-z][a-z0-9_]{0,31}_[A-Za-z0-9_-]{16,128}$", "type": "string"}, "type": "array", "uniqueItems": true},
    "canonical_key": {"anyOf": [{"pattern": "^[a-z][a-z0-9_]{0,31}_[A-Za-z0-9_-]{16,128}$", "type": "string"}, {"type": "null"}]},
    "entity_type": {"enum": ["patient", "encounter"]},
    "evidence": {"items": {"$ref": "#/$defs/evidence"}, "type": "array", "uniqueItems": true},
    "policy_id": {"pattern": "^[a-z][a-z0-9_.:/-]{0,127}$", "type": "string"},
    "policy_version": {"pattern": "^[1-9][0-9]*(\\.[0-9]+){0,2}$", "type": "string"},
    "request_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "resolution_id": {"pattern": "^[a-z][a-z0-9_]{0,31}_[A-Za-z0-9_-]{16,128}$", "type": "string"},
    "resolved_at": {"format": "date-time", "type": "string"},
    "resolver_id": {"pattern": "^[a-z][a-z0-9_.:/-]{0,127}$", "type": "string"},
    "resolver_version": {"pattern": "^[1-9][0-9]*(\\.[0-9]+){0,2}$", "type": "string"},
    "review_required": {"type": "boolean"},
    "schema_version": {"const": "1.0.0"},
    "source_keys": {"items": {"$ref": "#/$defs/sourceKey"}, "minItems": 1, "type": "array", "uniqueItems": true},
    "state": {"enum": ["matched", "unmatched", "ambiguous", "conflict"]}
  },
  "required": ["candidate_keys", "canonical_key", "entity_type", "evidence", "policy_id", "policy_version", "request_digest", "resolution_id", "resolved_at", "resolver_id", "resolver_version", "review_required", "schema_version", "source_keys", "state"],
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "matched"}}, "required": ["state"]},
      "then": {
        "properties": {
          "candidate_keys": {"maxItems": 1, "minItems": 1},
          "canonical_key": {"type": "string"},
          "review_required": {"const": false}
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "unmatched"}}, "required": ["state"]},
      "then": {
        "properties": {
          "candidate_keys": {"maxItems": 0},
          "canonical_key": {"type": "null"},
          "review_required": {"const": false}
        }
      }
    },
    {
      "if": {"properties": {"state": {"enum": ["ambiguous", "conflict"]}}, "required": ["state"]},
      "then": {
        "properties": {
          "candidate_keys": {"minItems": 1},
          "canonical_key": {"type": "null"},
          "review_required": {"const": true}
        }
      }
    }
  ],
  "schema_version": 1,
  "title": "OpenMedIdentityResolution",
  "type": "object"
}
