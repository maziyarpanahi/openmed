{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmed.dev/schemas/service_release_packet.schema.json",
  "title": "OpenMed v4.0 secure-service release packet",
  "description": "Signed, value-free decision packet produced by the v4.0 service release gate. It holds controlled codes, counts, issue references and digests only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "compatibility_policy", "release", "decision",
    "repository_binding", "evidence", "evidence_kinds", "p0_checklist",
    "p0_items", "moved_items", "sentinel_scan", "blocking_codes",
    "limitations", "manifest_digest", "reproduction", "packet_digest",
    "signature"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "compatibility_policy": {"const": "same_major"},
    "release": {
      "type": "object", "additionalProperties": false,
      "required": [
        "version", "target", "candidate_commit", "evaluated_at",
        "source_date_epoch"
      ],
      "properties": {
        "version": {"type": "string", "pattern": "^4\\.0\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]{1,32})?$"},
        "target": {"const": "v4.0"},
        "candidate_commit": {"$ref": "#/$defs/commit"},
        "evaluated_at": {"$ref": "#/$defs/timestamp"},
        "source_date_epoch": {"type": "integer", "minimum": 0}
      }
    },
    "decision": {"enum": ["READY", "NOT_READY"]},
    "repository_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["blocking_codes", "head_commit", "verified"],
      "properties": {
        "blocking_codes": {"$ref": "#/$defs/codes"},
        "head_commit": {"$ref": "#/$defs/commit"},
        "verified": {"type": "boolean"}
      }
    },
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence_row"}},
    "evidence_kinds": {"type": "array", "items": {"$ref": "#/$defs/kind_row"}},
    "p0_checklist": {
      "type": "object", "additionalProperties": false,
      "required": [
        "digest", "item_count", "protected_invariants", "release",
        "retargeted_from"
      ],
      "properties": {
        "digest": {"$ref": "#/$defs/digest"},
        "item_count": {"type": "integer", "minimum": 1},
        "protected_invariants": {"type": "array", "items": {"$ref": "#/$defs/plain_code"}},
        "release": {"$ref": "#/$defs/milestone"},
        "retargeted_from": {"$ref": "#/$defs/milestone"}
      }
    },
    "p0_items": {"type": "array", "items": {"$ref": "#/$defs/p0_row"}},
    "moved_items": {"type": "array", "items": {"$ref": "#/$defs/moved_row"}},
    "sentinel_scan": {
      "type": "object", "additionalProperties": false,
      "required": [
        "finding_count", "pattern_classes", "planted_sentinel_count",
        "planted_sentinel_digest", "scanned_entry_count"
      ],
      "properties": {
        "finding_count": {"type": "integer", "minimum": 0},
        "pattern_classes": {"type": "array", "items": {"$ref": "#/$defs/plain_code"}},
        "planted_sentinel_count": {"type": "integer", "minimum": 0},
        "planted_sentinel_digest": {"$ref": "#/$defs/digest"},
        "scanned_entry_count": {"type": "integer", "minimum": 0}
      }
    },
    "blocking_codes": {"$ref": "#/$defs/codes"},
    "limitations": {"type": "array", "items": {"$ref": "#/$defs/plain_code"}},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "reproduction": {
      "type": "object", "additionalProperties": false,
      "required": ["command", "evidence_count", "moved_item_count"],
      "properties": {
        "command": {
          "const": "python scripts/release/service_release_gate.py --manifest service-release-manifest.json --output service-release-packet.json"
        },
        "evidence_count": {"type": "integer", "minimum": 0},
        "moved_item_count": {"type": "integer", "minimum": 0}
      }
    },
    "packet_digest": {"$ref": "#/$defs/digest"},
    "signature": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["algorithm", "key_id", "value"],
          "properties": {
            "algorithm": {"const": "HMAC-SHA256"},
            "key_id": {"$ref": "#/$defs/code"},
            "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      ]
    }
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "issue": {"type": "string", "pattern": "^#[1-9][0-9]{0,6}$"},
    "milestone": {"type": "string", "pattern": "^v[0-9]{1,3}\\.[0-9]{1,3}(\\.[0-9]{1,3})?$"},
    "plain_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "code": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:#-]{0,159}$"},
    "codes": {"type": "array", "items": {"$ref": "#/$defs/code"}},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "kind": {
      "enum": [
        "security_profile_report", "no_egress_attestation",
        "recovery_drill_report", "migration_rehearsal_matrix",
        "protocol_map", "fixture", "failure_code_inventory", "p0_status",
        "threat_model"
      ]
    },
    "summary": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
      "additionalProperties": {
        "oneOf": [
          {"type": "boolean"},
          {"type": "integer", "minimum": 0},
          {"type": "string", "pattern": "^(sha256:[0-9a-f]{64}|[a-z0-9#][a-z0-9_.:#-]{0,63})$"}
        ]
      }
    },
    "evidence_row": {
      "type": "object", "additionalProperties": false,
      "required": [
        "age_seconds", "blocking_codes", "byte_size", "candidate_commit",
        "digest", "id", "kind", "loader", "scanned", "state", "summary"
      ],
      "properties": {
        "age_seconds": {"type": "integer", "minimum": 0},
        "blocking_codes": {"$ref": "#/$defs/codes"},
        "byte_size": {"type": "integer", "minimum": 0},
        "candidate_commit": {"$ref": "#/$defs/commit"},
        "digest": {"$ref": "#/$defs/digest"},
        "id": {"$ref": "#/$defs/id"},
        "kind": {"$ref": "#/$defs/kind"},
        "loader": {"enum": ["typed", "digest_only", "unavailable"]},
        "scanned": {"type": "boolean"},
        "state": {"enum": ["verified", "blocked"]},
        "summary": {"$ref": "#/$defs/summary"}
      }
    },
    "kind_row": {
      "type": "object", "additionalProperties": false,
      "required": ["blocking_codes", "entry_count", "kind", "producer", "required", "state"],
      "properties": {
        "blocking_codes": {"$ref": "#/$defs/codes"},
        "entry_count": {"type": "integer", "minimum": 0},
        "kind": {"$ref": "#/$defs/kind"},
        "producer": {"$ref": "#/$defs/issue"},
        "required": {"type": "boolean"},
        "state": {"enum": ["present", "not_present", "blocked"]}
      }
    },
    "p0_row": {
      "type": "object", "additionalProperties": false,
      "required": [
        "blocking_codes", "control", "issue", "missing_evidence",
        "required_evidence", "state", "status"
      ],
      "properties": {
        "blocking_codes": {"$ref": "#/$defs/codes"},
        "control": {"$ref": "#/$defs/plain_code"},
        "issue": {"$ref": "#/$defs/issue"},
        "missing_evidence": {"type": "array", "items": {"$ref": "#/$defs/kind"}},
        "required_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/kind"}},
        "state": {"enum": ["complete", "incomplete"]},
        "status": {"enum": ["closed", "open", "unknown"]}
      }
    },
    "moved_row": {
      "type": "object", "additionalProperties": false,
      "required": [
        "blocking_codes", "destination", "issue", "narrowed_claims",
        "priority", "rationale", "residual_risk"
      ],
      "properties": {
        "blocking_codes": {"$ref": "#/$defs/codes"},
        "destination": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/milestone"}]},
        "issue": {"$ref": "#/$defs/issue"},
        "narrowed_claims": {"type": "array", "items": {"$ref": "#/$defs/plain_code"}},
        "priority": {"enum": ["P0", "P1", "P2"]},
        "rationale": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/plain_code"}]},
        "residual_risk": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/plain_code"}]}
      }
    }
  }
}
