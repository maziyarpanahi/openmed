{
  "$defs": {
    "artifact": {
      "properties": {
        "artifact_id": {"pattern": "^[a-z][a-z0-9_]{0,31}_[A-Za-z0-9_-]{16,128}$", "type": "string"},
        "artifact_type": {"type": "string"},
        "attributes": {"type": "object"},
        "byte_size": {"minimum": 0, "type": "integer"},
        "content_hash": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
        "media_type": {"type": "string"},
        "recorded_at": {"format": "date-time", "type": "string"},
        "schema_version": {"pattern": "^1(?:\\.[0-9]+){0,2}$", "type": "string"},
        "source_id": {"pattern": "^[a-z][a-z0-9_]{0,31}_[A-Za-z0-9_-]{16,128}$", "type": "string"}
      },
      "required": ["artifact_id", "artifact_type", "attributes", "byte_size", "content_hash", "media_type", "recorded_at", "schema_version", "source_id"],
      "type": "object"
    },
    "locator": {
      "properties": {
        "artifact_id": {"pattern": "^[a-z][a-z0-9_]{0,31}_[A-Za-z0-9_-]{16,128}$", "type": "string"},
        "location": {"type": "object"},
        "location_type": {"enum": ["text_span", "json_pointer", "message_field", "document_path", "page_box", "dicom_element", "table_cell"]},
        "locator_id": {"pattern": "^[a-z][a-z0-9_]{0,31}_[A-Za-z0-9_-]{16,128}$", "type": "string"},
        "schema_version": {"pattern": "^1(?:\\.[0-9]+){0,2}$", "type": "string"},
        "transform": {"type": "object"}
      },
      "required": ["artifact_id", "location", "location_type", "locator_id", "schema_version", "transform"],
      "type": "object"
    }
  },
  "$id": "https://openmed.dev/schemas/v3/ingest/evidence-adapter-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact": {"$ref": "#/$defs/artifact"},
    "compatibility_policy": {"const": "same_major"},
    "coordinate_convention": {"enum": ["unicode_text_v1", "existing_document_v1", "fhir_json_pointer_v1", "hl7v2_field_component_v1", "cda_document_path_v1", "table_cell_v1"]},
    "locators": {"items": {"$ref": "#/$defs/locator"}, "type": "array", "uniqueItems": true},
    "normalization_transform": {"minProperties": 1, "type": "object"},
    "parser_id": {"pattern": "^[a-z][a-z0-9_.:/-]{0,127}$", "type": "string"},
    "parser_version": {"pattern": "^[1-9][0-9]*(\\.[0-9]+){0,2}$", "type": "string"},
    "result_id": {"pattern": "^[a-z][a-z0-9_]{0,31}_[A-Za-z0-9_-]{16,128}$", "type": "string"},
    "schema_version": {"const": "1.0.0"},
    "source_byte_size": {"minimum": 0, "type": "integer"},
    "source_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "source_format": {"enum": ["text", "document", "fhir_r4", "hl7v2", "cda", "csv", "xlsx"]},
    "source_version": {"pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$", "type": "string"}
  },
  "required": ["artifact", "compatibility_policy", "coordinate_convention", "locators", "normalization_transform", "parser_id", "parser_version", "result_id", "schema_version", "source_byte_size", "source_digest", "source_format", "source_version"],
  "schema_version": 1,
  "title": "OpenMedStructuredEvidenceResult",
  "type": "object"
}
