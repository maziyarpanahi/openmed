{
  "schema": "openmed.tests.sdk_config_parity",
  "version": 1,
  "synthetic": true,
  "description": "Synthetic portable SDK configuration vectors. Every runtime must accept each valid config and return its resolved form, and must reject each invalid config with exactly the listed issues in order. Issues carry a code and a known field name only; document-level issues have a null field. Model ids and revisions are invented.",
  "sdk_config_schema": "https://openmed.life/schemas/sdk_config.schema.json",
  "sdk_config_version": 1,
  "reference": "openmed.core.sdk_config.validate_sdk_config",
  "fields": [
    "confidence_threshold",
    "local_only",
    "model_id",
    "model_revision",
    "onnx_variant",
    "policy_profile"
  ],
  "defaults": {
    "confidence_threshold": 0.5,
    "local_only": true,
    "model_id": null,
    "model_revision": null,
    "onnx_variant": "auto",
    "policy_profile": "hipaa_safe_harbor"
  },
  "issue_codes": [
    "config_not_object",
    "invalid_format",
    "missing_dependency",
    "not_allowed_value",
    "out_of_range",
    "unknown_field",
    "wrong_type"
  ],
  "issue_order": "config_not_object alone when the document is not an object; otherwise at most one unknown_field (field null), then at most one issue per field in fields order",
