  "cases": [
    {
      "id": "no-filter-returns-every-row-in-catalog-order",
      "query": {},
      "expected_repo_ids": [
        "Synthetic/alpha-tiny-onnx",
        "Synthetic/bravo-small-onnx",
        "Synthetic/charlie-base-tflite",
        "Synthetic/delta-untiered-onnx",
        "Synthetic/echo-large-onnx",
        "Synthetic/foxtrot-zero-onnx"
      ]
    },
    {
      "id": "format-is-case-insensitive-equality",
      "query": {"format": "OnNx"},
      "expected_repo_ids": [
        "Synthetic/alpha-tiny-onnx",
        "Synthetic/bravo-small-onnx",
        "Synthetic/echo-large-onnx"
      ]
    },
    {
      "id": "format-does-not-match-by-prefix",
      "query": {"format": "onnx-int"},
      "expected_repo_ids": []
    },
    {
      "id": "format-matches-any-listed-format",
      "query": {"format": "TFLITE"},
