{
  "schema": "openmed.tests.model_lifecycle_parity",
  "version": 1,
  "synthetic": true,
  "description": "Ordered openmed.model.lifecycle.v1 event sequences from the Python emitters. Repository ids, file names, contents and commit hashes are invented. Each scenario is replayed against an in-process fake Hub or a temporary cache. Events carry repo ids, commit hashes, counts, digests and reason codes only.",
  "event_schema": "https://openmed.life/schemas/model_lifecycle_event.schema.json",
  "event_schema_version": "openmed.model.lifecycle.v1",
  "reference": "openmed.core.hf_hub.prefetch_model, openmed.core.model_cache_policy.ModelCachePolicy, openmed.core.model_lifecycle",
  "event_types": [
    "requested",
    "fetching",
    "verified",
    "integrity_failed",
    "ready",
    "activated",
    "rolled_back",
    "evicted",
    "failed"
  ],
  "event_fields": [
    "schema_version",
    "event",
    "repo_id",
    "revision_sha",
    "file_count",
    "byte_count",
    "digest",
    "reason"
  ],
  "reason_codes": [
    "artifact_absent",
    "commit_unverifiable",
    "corrupt_file_unremovable",
    "digest_mismatch",
    "download_error",
    "file_missing",
    "integrity_retry_exhausted",
    "integrity_unverifiable",
    "metadata_invalid_filename",
    "metadata_missing_digest",
    "metadata_missing_size",
    "no_matching_files",
    "offline_cache_miss",
    "revision_name_unsafe",
    "size_mismatch"
  ],
