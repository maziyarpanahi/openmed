{
  "description": "Synthetic requests and results frozen from the 1.0.0 fixed-option decision contract. They must keep validating and deciding exactly as recorded.",
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://openmed.dev/schemas/decision-request/1.0.0",
    "title": "OpenMed Fixed-Option Decision Request",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "mode",
      "input_text"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "mode": {
              "const": "scalar_score"
            }
          }
        },
        "then": {
          "properties": {
            "options": {
              "maxItems": 0
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "mode": {
              "const": "boolean_choice"
            }
          }
        },
        "then": {
          "properties": {
            "options": {
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "mode": {
              "enum": [
                "fixed_choice",
                "ordered_preference",
                "multi_label"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "options": {
              "minItems": 2,
              "maxItems": 64
            }
          }
        }
      }
    ],
    "properties": {
      "mode": {
        "type": "string",
        "enum": [
          "fixed_choice",
          "boolean_choice",
          "ordered_preference",
          "scalar_score",
          "multi_label"
        ]
      },
      "input_text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      },
      "options": {
        "type": "array",
        "maxItems": 64,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "default": []
      },
      "namespace": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.:/-]{0,127}$",
        "default": "default"
      },
      "purpose": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.:/-]{0,127}$",
        "default": "care_review"
      },
      "calibration_id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.:/-]{0,127}$",
        "default": "openmed.synthetic.fixed_option.v1"
      },
      "timeout_ms": {
        "type": "integer",
        "minimum": 1,
        "maximum": 30000,
        "default": 5000
      },
      "schema_version": {
        "type": "string",
        "const": "1.0.0",
        "default": "1.0.0"
      },
      "compatibility_policy": {
        "type": "string",
        "const": "same_major",
        "default": "same_major"
      }
    }
  },
  "result_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://openmed.dev/schemas/decision-result/1.0.0",
    "title": "OpenMed Fixed-Option Decision Result",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "mode",
      "state",
      "code",
      "option_scores",
      "choice",
      "choices",
      "ranking",
      "scalar_score",
      "confidence",
      "margin",
      "calibration",
      "backend",
      "access",
      "warnings",
      "review",
      "advisory",
      "autonomous_action",
      "schema_version",
      "compatibility_policy",
      "extensions"
    ],
    "properties": {
      "mode": {
        "type": "string",
        "enum": [
          "fixed_choice",
          "boolean_choice",
          "ordered_preference",
          "scalar_score",
          "multi_label"
        ]
      },
      "state": {
        "type": "string",
        "enum": [
          "success",
          "abstained",
          "partial",
          "unknown",
          "conflict",
          "unsupported",
          "denied",
          "failure"
        ]
      },
      "code": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:/-]{0,127}$"
          },
          {
            "type": "null"
          }
        ]
      },
      "option_scores": {
        "type": "array",
        "maxItems": 64,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "index",
            "option",
            "score"
          ],
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "option": {
              "type": "string",
              "maxLength": 256
            },
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      },
      "choice": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 256
      },
      "choices": {
        "type": "array",
        "maxItems": 64,
        "items": {
          "type": "string",
          "maxLength": 256
        }
      },
      "ranking": {
        "type": "array",
        "maxItems": 64,
        "items": {
          "type": "string",
          "maxLength": 256
        }
      },
      "scalar_score": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0,
        "maximum": 1
      },
      "confidence": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0,
        "maximum": 1
      },
      "margin": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0,
        "maximum": 1
      },
      "calibration": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "calibration_id",
          "version",
          "method",
          "minimum_confidence",
          "minimum_margin",
          "multi_label_threshold",
          "in_domain_digest",
          "out_of_domain_digest"
        ],
        "properties": {
          "calibration_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:/-]{0,127}$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
          },
          "method": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:/-]{0,127}$"
          },
          "minimum_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minimum_margin": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "multi_label_threshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "in_domain_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "out_of_domain_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      },
      "backend": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "backend_id",
          "kind",
          "runtime",
          "model_id",
          "revision",
          "license_id",
          "local",
          "deterministic"
        ],
        "properties": {
          "backend_id": {
            "type": "string",
            "maxLength": 256
          },
          "kind": {
            "type": "string",
            "enum": [
              "deterministic",
              "encoder",
              "cross_encoder",
              "specialist"
            ]
          },
          "runtime": {
            "type": "string",
            "maxLength": 256
          },
          "model_id": {
            "type": "string",
            "maxLength": 256
          },
          "revision": {
            "type": "string",
            "maxLength": 256
          },
          "license_id": {
            "type": "string",
            "enum": [
              "Apache-2.0",
              "BSD-2-Clause",
              "BSD-3-Clause",
              "MIT",
              "MPL-2.0"
            ]
          },
          "local": {
            "type": "boolean",
            "const": true
          },
          "deterministic": {
            "type": "boolean"
          }
        }
      },
      "access": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "allowed",
          "code",
          "namespace",
          "purpose",
          "policy_version"
        ],
        "properties": {
          "allowed": {
            "type": "boolean"
          },
          "code": {
            "anyOf": [
              {
                "type": "string",
