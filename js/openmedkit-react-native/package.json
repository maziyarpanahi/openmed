{
  "name": "@openmed/openmedkit-react-native",
  "version": "0.1.0",
  "description": "React Native bridge for OpenMedKit on-device de-identification.",
  "private": true,
  "main": "./src/index.ts",
  "react-native": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "android/build.gradle",
    "android/src/main",
    "ios",
    "src",
    "openmedkit-react-native.podspec",
    "react-native.config.js",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!ios/build"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && npm run test:node",
    "test:node": "tsx --test ../../tests/mobile/test_rn_bridge_parity.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.77"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0"
}
